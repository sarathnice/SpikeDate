# Use Cloudflare D1/R2 APIs as the source of truth for signed-in app data.
# Keep false for the offline design preview; set true in development/staging.
NEXT_PUBLIC_SPIKEDATE_SERVER_DATA_ENABLED=false

# Premium phone onboarding. Local development uses the deterministic 123456
# code; staging/production should use Firebase Identity Platform.
NEXT_PUBLIC_SPIKEDATE_PHONE_VERIFICATION_ENABLED=true
SPIKEDATE_PHONE_VERIFICATION_REQUIRED=true
SPIKEDATE_PHONE_VERIFICATION_PROVIDER=mock
SPIKEDATE_PHONE_VERIFICATION_TOKEN_SECRET=replace-with-a-long-random-secret
FIREBASE_IDENTITY_PLATFORM_API_KEY=

# Safety kill switch for the private Plan a Date experience. Disable both in
# any environment where plan safety controls are not ready for release.
NEXT_PUBLIC_SPIKEDATE_DATE_PLANS_ENABLED=true
SPIKEDATE_DATE_PLANS_ENABLED=true

# Overall deployment kill switch. When false, all voice UI is hidden.
NEXT_PUBLIC_PULSE_VOICE_ENABLED=true

# The low-cost, one-command-at-a-time voice experience.
NEXT_PUBLIC_PULSE_VOICE_COMMAND_ENABLED=false

# Continuous conversation. Disable independently if realtime usage is too costly.
NEXT_PUBLIC_PULSE_VOICE_LIVE_ENABLED=false

# Cloudflare Whisper fallback. Enable both only where AI usage is intended.
NEXT_PUBLIC_PULSE_VOICE_CLOUD_ENABLED=false
PULSE_VOICE_CLOUD_ENABLED=false

# Uses browser/device voice with no paid AI. Keep true for local and staging tests.
NEXT_PUBLIC_PULSE_VOICE_TEST_MODE=true

# Optional live venue search for Galaxy plans. Without this token, the app uses
# built-in development venues so the complete flow remains testable.
MAPBOX_ACCESS_TOKEN=

# Development/staging billing adapter. Store receipts are always verified
# server-side once Apple/Google credentials are configured.
SPIKEDATE_BILLING_MODE=mock

# Require Cloudflare Access identity in addition to SpikeDate RBAC for /admin.
# Keep false only for local UI testing.
SPIKEDATE_ADMIN_ACCESS_REQUIRED=false

# Synthetic accounts are isolated under @spikedate.test and cannot be seeded
# unless both values are explicitly configured.
SPIKEDATE_TEST_SEED_ENABLED=false
SPIKEDATE_TEST_SEED_SECRET=

# Camera verification mode. Use mock only for local/test environments. Keep
# manual until a production liveness and face-matching provider is connected.
SPIKEDATE_FACE_VERIFICATION_MODE=manual

# Local development approves uploaded media immediately. Use manual in staging
# until an automated moderation provider is connected.
SPIKEDATE_MEDIA_MODERATION_MODE=mock

# Push notifications are stored in-app without credentials. FCM delivery is
# enabled only when provider is `fcm` and both values are configured.
SPIKEDATE_PUSH_PROVIDER=in_app
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

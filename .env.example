# Overall deployment kill switch. When false, all voice UI is hidden.
NEXT_PUBLIC_PULSE_VOICE_ENABLED=true

# The low-cost, one-command-at-a-time voice experience.
NEXT_PUBLIC_PULSE_VOICE_COMMAND_ENABLED=true

# Continuous conversation. Disable independently if realtime usage is too costly.
NEXT_PUBLIC_PULSE_VOICE_LIVE_ENABLED=true

# Cloudflare Whisper fallback. Enable both only where AI usage is intended.
NEXT_PUBLIC_PULSE_VOICE_CLOUD_ENABLED=false
PULSE_VOICE_CLOUD_ENABLED=false

# Uses browser/device voice with no paid AI. Keep true for local and staging tests.
NEXT_PUBLIC_PULSE_VOICE_TEST_MODE=true

# Optional live venue search for Galaxy plans. Without this token, the app uses
# built-in development venues so the complete flow remains testable.
MAPBOX_ACCESS_TOKEN=

# Development/staging billing adapter. Store receipts are always verified
# server-side once Apple/Google credentials are configured.
SPIKEDATE_BILLING_MODE=mock

# Require Cloudflare Access identity in addition to SpikeDate RBAC for /admin.
# Keep false only for local UI testing.
SPIKEDATE_ADMIN_ACCESS_REQUIRED=false

# Synthetic accounts are isolated under @spikedate.test and cannot be seeded
# unless both values are explicitly configured.
SPIKEDATE_TEST_SEED_ENABLED=false
SPIKEDATE_TEST_SEED_SECRET=

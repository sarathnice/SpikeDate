{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spikedate-profile-demo-local",
  "main": "workers/profile-demo-local.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist/client" },
  "durable_objects": {
    "bindings": [{ "name": "ARCADE_ROOMS", "class_name": "ArcadeRoom" }]
  },
  "migrations": [{ "tag": "arcade-v1", "new_sqlite_classes": ["ArcadeRoom"] }],
  "vars": {
    "SPIKEDATE_LOCAL_PROFILE_DEMO": "true",
    "SPIKEDATE_ARCADE_ENABLED": "true",
    "SPIKEDATE_BILLING_MODE": "mock",
    "SPIKEDATE_PHONE_VERIFICATION_PROVIDER": "mock",
    "SPIKEDATE_PHONE_VERIFICATION_REQUIRED": "true",
    "SPIKEDATE_PUSH_PROVIDER": "in_app",
    "SPIKEDATE_MEDIA_MODERATION_MODE": "manual",
    "SPIKEDATE_IMAGES_ENABLED": "false"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "spikedate-profile-demo-local",
    "database_id": "22222222-2222-4222-8222-222222222222",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "spikedate-profile-demo-local-media" }]
}

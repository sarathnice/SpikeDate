{
  "name": "spikedate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-face-assets.mjs",
    "prebuild": "node scripts/prepare-face-assets.mjs",
    "prebuild:staging": "node scripts/prepare-face-assets.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "build:staging": "cross-env NEXT_PUBLIC_SPIKEDATE_SERVER_DATA_ENABLED=true NEXT_PUBLIC_SPIKEDATE_DATE_PLANS_ENABLED=true vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "docker:dev": "docker compose --profile dev up --build",
    "docker:staging": "docker compose --profile staging up --build",
    "mobile:sync": "cap sync",
    "mobile:sync:stage": "cross-env SPIKEDATE_STAGING_URL=https://spikedate-stage.sarathnice.workers.dev cap sync",
    "mobile:sync:android": "cross-env SPIKEDATE_STAGING_URL=http://10.0.2.2:3000 cap sync android",
    "mobile:sync:ios": "cross-env SPIKEDATE_STAGING_URL=http://localhost:3000 cap sync ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "db:generate": "drizzle-kit generate",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --config wrangler.stage.jsonc",
    "deploy:cloudflare:staging": "npm run build:staging && npm run db:migrate:staging && wrangler deploy --config wrangler.stage.jsonc",
    "test": "vitest run",
    "test:ui": "playwright test",
    "arcade:local": "wrangler dev --config wrangler.arcade-local.jsonc --port 3007 --persist-to outputs/qa/arcade/local-state",
    "test:arcade:ui": "cross-env SPIKEDATE_UI_URL=http://127.0.0.1:3007 SPIKEDATE_QA_REPORT_DIR=outputs/qa/arcade/retest playwright test tests/playwright/arcade-live.spec.ts",
    "qa": "node tests/qa/run.mjs",
    "qa:stage": "node tests/qa/run.mjs --url https://spikedate-stage.sarathnice.workers.dev --open",
    "test:qa": "node --test tests/qa/report.test.mjs",
    "test:all": "npm run lint && npm run test && npm run build && npm run test:ui",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.6",
    "@aws-amplify/ui-react-liveness": "^3.6.9",
    "@aws-sdk/client-rekognition": "^3.1137.0",
    "@base-ui/react": "1.7.0",
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.4.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "8.4.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@mediapipe/tasks-vision": "0.10.32",
    "@shadcn/react": "0.3.0",
    "aws-amplify": "^6.22.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260907.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^3.2.4",
    "wrangler": "4.129.1"
  },
  "type": "module"
}
